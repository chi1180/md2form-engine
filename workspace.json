{
  "title": "md2form Full Feature Playground",
  "pages": [
    {
      "title": "Text Inputs",
      "description": "",
      "elements": [
        {
          "type": "short_text",
          "description": "Short Text: Full Name",
          "placeholder": "山田 太郎",
          "required": true,
          "maxLength": 60,
          "default": "",
          "visible": true
        },
        {
          "type": "long_text",
          "description": "Long Text: Self Introduction",
          "placeholder": "自己紹介を入力してください",
          "required": false,
          "maxLength": 300
        },
        {
          "type": "number",
          "description": "Number: Years of Experience",
          "placeholder": "3",
          "required": true,
          "min": 0,
          "max": 40,
          "step": 1,
          "integerOnly": true
        },
        {
          "type": "email",
          "description": "Email: Contact Email",
          "placeholder": "you@example.com",
          "required": true
        },
        {
          "type": "phone",
          "description": "Phone: Mobile Number",
          "placeholder": "090-1234-5678",
          "required": false
        }
      ]
    },
    {
      "title": "Choice Inputs",
      "description": "",
      "elements": [
        {
          "type": "dropdown",
          "description": "Dropdown: Preferred Work Style",
          "options": [
            "Remote",
            "Hybrid",
            "Office"
          ],
          "searchable": true,
          "allowOther": false,
          "required": true
        },
        {
          "type": "radio",
          "description": "Radio: Preferred Contact Method",
          "options": [
            "Email",
            "Phone",
            "Chat"
          ],
          "allowOther": false,
          "required": true
        },
        {
          "type": "checkbox",
          "description": "Checkbox: Skills",
          "options": [
            "TypeScript",
            "React",
            "Node.js",
            "Design"
          ],
          "required": true,
          "minSelected": 1,
          "maxSelected": 3
        }
      ]
    },
    {
      "title": "Date and Time",
      "description": "",
      "elements": [
        {
          "type": "date",
          "description": "Date: Available Start Date",
          "required": true,
          "includeTime": false,
          "minDate": "2026-01-01",
          "maxDate": "2027-12-31"
        },
        {
          "type": "time",
          "description": "Time: Preferred Interview Time",
          "required": true,
          "minTime": "09:00",
          "maxTime": "18:00",
          "stepMinutes": 30
        }
      ]
    },
    {
      "title": "Scale and Evaluation",
      "description": "",
      "elements": [
        {
          "type": "rating",
          "description": "Rating: Product Satisfaction",
          "required": true,
          "scale": 5,
          "labels": {
            "low": "不満",
            "high": "満足"
          },
          "icon": "star"
        },
        {
          "type": "likert",
          "description": "Likert: Team Survey",
          "required": false,
          "statements": [
            "目標が明確",
            "協力しやすい",
            "学習機会がある"
          ],
          "scaleLabels": [
            "全くそう思わない",
            "そう思わない",
            "普通",
            "そう思う",
            "とてもそう思う"
          ],
          "requiredPerStatement": true
        },
        {
          "type": "matrix",
          "description": "Matrix: Weekly Availability",
          "required": false,
          "rows": [
            "月",
            "火",
            "水",
            "木",
            "金"
          ],
          "columns": [
            "午前",
            "午後",
            "夜"
          ],
          "cellType": "checkbox",
          "requiredPerRow": false
        },
        {
          "type": "scale",
          "description": "Scale: Confidence Level",
          "required": true,
          "min": 1,
          "max": 10,
          "step": 1,
          "minLabel": "低い",
          "maxLabel": "高い"
        }
      ]
    },
    {
      "title": "Upload and Signature",
      "description": "",
      "elements": [
        {
          "type": "file_upload",
          "description": "File Upload: Portfolio",
          "required": false,
          "allowedTypes": [
            "pdf",
            "docx",
            "jpg",
            "png"
          ],
          "maxFiles": 3,
          "maxSizeMB": 20
        },
        {
          "type": "signature",
          "description": "Signature: Agreement",
          "required": true,
          "captureMode": "draw"
        }
      ]
    },
    {
      "title": "Media and Layout",
      "description": "",
      "elements": [
        {
          "type": "image",
          "description": "Image: Company Logo",
          "src": "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab",
          "alt": "Company logo",
          "width": "auto",
          "height": "auto",
          "caption": "Sample image block"
        },
        {
          "type": "video",
          "description": "Video: Intro Clip",
          "src": "https://example.com/intro.mp4",
          "width": "auto",
          "height": "auto",
          "caption": "Sample video block"
        },
        {
          "type": "boolean",
          "description": "Boolean: Accept Terms",
          "required": true,
          "onLabel": "同意する",
          "offLabel": "同意しない"
        },
        {
          "type": "section_header",
          "description": "Section Header: Additional Notes",
          "title": "追加情報",
          "subtitle": "必要に応じて補足を入力してください"
        }
      ]
    }
  ],
  "settings": {
    "collectEmail": true,
    "allowMultipleResponses": false,
    "limitResponses": 500,
    "showProgressBar": true,
    "shuffleQuestions": false,
    "responseReceipt": "whenRequested",
    "themeColor": "#2563EB",
    "backgroundImage": "mountain",
    "font": "Noto Sans JP, sans-serif"
  },
  "description": "This sample includes all major question types and representative properties."
}